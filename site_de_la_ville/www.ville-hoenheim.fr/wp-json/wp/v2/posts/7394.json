-21-150x150.jpeg 150w, https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-21-235x235.jpeg 235w\" sizes=\"(max-width: 150px) 100vw, 150px\" \/><\/a>\n\t\t\t<\/dt><\/dl><br style=\"clear: both\" \/><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon portrait'>\n\t\t\t\t<a href='https:\/\/www.ville-hoenheim.fr\/des-jeunes-pousses-rue-de-la-fontaine\/image-44\/'><img width=\"150\" height=\"150\" src=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-20-150x150.jpeg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-20-150x150.jpeg 150w, https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-20-235x235.jpeg 235w\" sizes=\"(max-width: 150px) 100vw, 150px\" \/><\/a>\n\t\t\t<\/dt><\/dl><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon portrait'>\n\t\t\t\t<a href='https:\/\/www.ville-hoenheim.fr\/des-jeunes-pousses-rue-de-la-fontaine\/image-43\/'><img width=\"150\" height=\"150\" src=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-19-150x150.jpeg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-19-150x150.jpeg 150w, https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-19-235x235.jpeg 235w\" sizes=\"(max-width: 150px) 100vw, 150px\" \/><\/a>\n\t\t\t<\/dt><\/dl><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon portrait'>\n\t\t\t\t<a href='https:\/\/www.ville-hoenheim.fr\/des-jeunes-pousses-rue-de-la-fontaine\/image-42\/'><img width=\"150\" height=\"150\" src=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-18-150x150.jpeg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" loading=\"lazy\" srcset=\"https:\/\/www.ville-hoenheim.fr\/wp-content\/uploads\/2022\/01\/image-18-150x150.jpeg 150w, https:\/\/www.ville-hoenheim.fr\/wp-content\/u